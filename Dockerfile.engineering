FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Tkinter runtime for desktop UI
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-tk tk \
    && rm -rf /var/lib/apt/lists/*

COPY engineering_calculator.py /app/engineering_calculator.py

CMD ["python", "engineering_calculator.py"]
